{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["es2023", "dom"],
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "e2e/**/*.ts", "bench/**/*.ts"]
}
